{
  "permissions": {
    "allow": [
      "Bash(python .claude/pipeline/pipeline.py status)",
      "Bash(python .claude/pipeline/pipeline.py overview)",
      "Bash(python .claude/pipeline/pipeline.py approve-tests)",
      "Bash(python .claude/pipeline/pipeline.py unlock-tests)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/pipeline/pipeline.py\" session-start || exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/pipeline/pipeline.py\" guard || exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
